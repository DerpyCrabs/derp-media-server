{
  "name": "derp-media-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cargo run",
    "build:client": "vite build && bun scripts/generate-service-worker.ts",
    "build": "bun run build:client && cargo build --release",
    "start": "bun run build && cargo run --release -- --production",
    "tsgo": "tsgo -p tsconfig.json",
    "lint": "oxlint",
    "lint-errors": "oxlint --quiet",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "bun run build && playwright test",
    "test:unit": "cargo test && bun test tests/unit/",
    "test:batch": "bun run build && bun tests/run-batches.ts",
    "test:generate-media": "bun tests/fixtures/generate-media-cache.ts",
    "test:ui": "bun run build && playwright test --ui",
    "test:headed": "bun run build && playwright test --headed",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@lezer/common": "^1.5.2",
    "@lezer/markdown": "^1.7.2",
    "@tanstack/solid-query": "^5.101.0",
    "@tanstack/solid-virtual": "^3.13.29",
    "@xmldom/xmldom": "^0.9.10",
    "clsx": "^2.1.1",
    "entities": "^7.0.1",
    "fflate": "^0.8.3",
    "lucide-solid": "1.20.0",
    "lucide-static": "^1.20.0",
    "pdfjs-dist": "^6.1.200",
    "solid-js": "^1.9.13",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.3",
    "@types/turndown": "^5.0.6",
    "@typescript/native-preview": "^7.0.0-dev.20260616.1",
    "eslint-plugin-solid": "^0.14.5",
    "happy-dom": "^20.10.5",
    "husky": "^9.1.7",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "oxlint-tsgolint": "^0.23.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12"
  },
  "ignoreScripts": [
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
