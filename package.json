{
  "name": "derp-media-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cargo run",
    "build:client": "vite build",
    "build": "bun run build:client && cargo build --release",
    "start": "bun run build && cargo run --release -- --production",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "bun run build && playwright test",
    "test:unit": "cargo test && bun test tests/unit/",
    "test:batch": "bun run build:client && cargo build --release --target-dir target/test-batch && bun tests/run-batches.ts",
    "test:generate-media": "bun tests/fixtures/generate-media-cache.ts",
    "test:ui": "bun run build && playwright test --ui",
    "test:headed": "bun run build && playwright test --headed",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lezer/common": "^1.5.2",
    "@lezer/markdown": "^1.7.2",
    "@solidjs/web": "2.0.0-rc.0",
    "@tanstack/solid-query": "6.0.0-rc.0",
    "@tanstack/virtual-core": "^3.13.36",
    "@xmldom/xmldom": "^0.9.11",
    "clsx": "^2.1.1",
    "entities": "^8.0.0",
    "fflate": "^0.8.3",
    "lucide-solid": "1.31.0",
    "lucide-static": "^1.31.0",
    "pdfjs-dist": "^6.2.108",
    "solid-js": "2.0.0-rc.0",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@solidjs/vite-plugin": "3.0.0-next.28",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/turndown": "^5.0.6",
    "eslint-plugin-solid": "~0.15.0",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.2.1"
  },
  "ignoreScripts": [
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
