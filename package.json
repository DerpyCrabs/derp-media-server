{
  "name": "derp-media-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cargo run",
    "build:client": "vite build",
    "build": "bun run build:client && cargo build --release",
    "start": "bun run build && cargo run --release -- --production",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "bun run build && playwright test",
    "test:unit": "cargo test && bun test tests/unit/",
    "test:batch": "bun run build:client && cargo build --release --target-dir target/test-batch && bun tests/run-batches.ts",
    "test:reactivity": "playwright test --config playwright.reactivity.config.ts",
    "test:generate-media": "bun tests/fixtures/generate-media-cache.ts",
    "test:ui": "bun run build && playwright test --ui",
    "test:headed": "bun run build && playwright test --headed",
    "prepare": "husky",
    "test:batch:dev": "cargo build --release --target-dir target/test-batch && E2E_DEV=1 bun tests/run-batches.ts",
    "build:desktop": "bun desktop/build.ts",
    "desktop": "bun run build:desktop && dist/desktop/derp-media-client",
    "package:arch": "bun desktop/package-arch.ts",
    "test:desktop": "bun run build:client && bun desktop/build.ts --tests && cargo build --release --target-dir target/test-batch && bun tests/desktop/smoke.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@effectweb/lucide": "file:../EffectWeb/packages/lucide",
    "@effectweb/query": "file:../EffectWeb/packages/query",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lezer/common": "^1.5.2",
    "@lezer/markdown": "^1.7.2",
    "@xmldom/xmldom": "^0.9.12",
    "clsx": "^2.1.1",
    "effect": "4.0.0-rc.112",
    "effectweb": "file:../EffectWeb/packages/runtime",
    "entities": "^8.1.0",
    "fflate": "^0.8.3",
    "lucide-static": "^1.45.0",
    "pdfjs-dist": "^6.3.289",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@effectweb/compiler": "file:../EffectWeb/packages/compiler",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.0",
    "@types/turndown": "^5.0.6",
    "happy-dom": "^20.14.3",
    "husky": "^9.1.7",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.0"
  },
  "ignoreScripts": [
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
