[Unit]
Description=Derp Media Server desktop tray
PartOf=graphical-session.target
After=graphical-session-pre.target

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.derp
ExecStart=/usr/bin/derp-media-client --tray
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
