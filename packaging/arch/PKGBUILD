pkgname=derp-media-client
pkgver=0.1.0
pkgrel=2
pkgdesc='Qt file browser, media viewer and file chooser portal for Derp Media Server'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-webengine' 'qt6-webchannel' 'kwindowsystem')
makedepends=('cmake' 'ninja' 'gcc')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  cmake -S desktop/qt -B build -G Ninja -DCMAKE_BUILD_TYPE=Release
  cmake --build build
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 build/derp-media-client "$pkgdir/usr/bin/derp-media-client"
  install -Dm644 packaging/arch/derp-media-client.desktop "$pkgdir/usr/share/applications/derp-media-client.desktop"
  install -Dm644 packaging/arch/derp-media-client.service "$pkgdir/usr/lib/systemd/user/derp-media-client.service"
  install -Dm644 packaging/arch/derp.portal "$pkgdir/usr/share/xdg-desktop-portal/portals/derp.portal"
  install -Dm644 packaging/arch/org.freedesktop.impl.portal.desktop.derp.service "$pkgdir/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.derp.service"
  install -Dm644 desktop/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/derp-media-client.svg"
  install -Dm644 packaging/arch/desktop.example.json "$pkgdir/usr/share/$pkgname/desktop.example.json"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 desktop/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
