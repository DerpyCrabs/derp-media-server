[Desktop Entry]
Type=Application
Name=Derp Files
Comment=Browse files, folders and archives
Exec=derp-media-client -- %U
Icon=derp-files
Terminal=false
Categories=System;FileManager;FileTools;
MimeType=inode/directory;application/zip;application/x-tar;application/gzip;application/x-compressed-tar;application/x-xz-compressed-tar;
StartupNotify=true
StartupWMClass=derp-media-client
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New browser window
Exec=derp-media-client
